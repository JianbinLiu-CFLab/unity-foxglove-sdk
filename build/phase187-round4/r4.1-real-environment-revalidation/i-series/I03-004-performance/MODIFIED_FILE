<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Performance tests must exercise the SDK surface only; bridge sources
         are opt-in and otherwise contaminate the evaluated compile set. -->
    <IncludeRos2Bridge Condition="'$(IncludeRos2Bridge)' == ''">false</IncludeRos2Bridge>
  </PropertyGroup>

  <Import Project="../FoxgloveSdk.TestSurface.props" />

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PerformanceResult.cs" />
    <Compile Include="PerformanceRunner.cs" />
    <Compile Include="FakePerformanceTransport.cs" />
    <Compile Include="../Unit/Fixtures/UnityEngineMathTypes.cs" Link="Fixtures/UnityEngineMathTypes.cs" />
  </ItemGroup>
</Project>
