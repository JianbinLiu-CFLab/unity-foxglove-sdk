+        private static void ReplayChunkCrcPolicyEmitsWarningsAndThrows()
+        {
+            var path = TempMcapPath();
+            try
+            {
+                File.WriteAllBytes(path, BuildChunkMcap(badCrc: true, reverseChunkIndexOrder: false));
+
+                var logger = new RecordingLogger();
+                using (var engine = new McapReplayEngine(logger))
+                {
+                    engine.Load(path);
+                    var result = engine.Snapshot(ulong.MaxValue, new List<McapMessage>());
+                    Check(result.Count == 1,
+                        "134-10E-3: warning policy keeps the corrupt chunk readable");
+                    Check(logger.Warnings.Count == 2
+                          && logger.Warnings.All(message => message.Contains(
+                              "CRC mismatch; data may be corrupted.",
+                              StringComparison.Ordinal)),
+                        "134-10E-4: warning policy emits one diagnostic per corrupt chunk");
+                }
+
+                var strictLogger = new RecordingLogger();
+                using (var strict = new McapReplayEngine(strictLogger)
+                       {
+                           CrcMismatchPolicy = McapReplayEngine.CorruptChunkPolicy.Throw
+                       })
+                {
+                    strict.Load(path);
+                    var threw = false;
+                    try
+                    {
+                        strict.Snapshot(ulong.MaxValue, new List<McapMessage>());
+                    }
+                    catch (InvalidDataException exception)
+                    {
+                        threw = exception.Message.Contains(
+                            "CRC mismatch; data may be corrupted.",
+                            StringComparison.Ordinal);
+                    }
+
+                    Check(threw,
+                        "134-10E-5: throw policy raises the documented CRC mismatch exception");
+                    Check(strictLogger.Warnings.Count == 1,
+                        "134-10E-6: throw policy records the warning before raising");
+                }
+            }
+            finally
+            {
+                TryDelete(path);
+            }
+        }
