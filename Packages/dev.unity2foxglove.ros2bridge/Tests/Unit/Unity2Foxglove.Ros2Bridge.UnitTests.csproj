<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IncludeRos2Bridge>true</IncludeRos2Bridge>
    <IncludeRos2ForUnityAdapter>false</IncludeRos2ForUnityAdapter>
    <IncludeRos2ForUnityNative>false</IncludeRos2ForUnityNative>
    <AssemblyName>Unity2Foxglove.Ros2Bridge.UnitTests</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\..\build\Tests\Ros2Bridge\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\build\Tests\Ros2Bridge\obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <Import Project="../../../dev.unity2foxglove.sdk/Tests/FoxgloveSdk.TestSurface.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**/*.cs;obj/**/*.cs" />
    <Compile Include="../../Editor/FoxRun/Ros2CustomCdrEmitter.cs"
             Link="Editor/FoxRun/Ros2CustomCdrEmitter.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/Generation.cs" Link="Editor/FoxRun/Decomposed/Generation.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/Readers.cs" Link="Editor/FoxRun/Decomposed/Readers.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/Writers.cs" Link="Editor/FoxRun/Decomposed/Writers.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/ValidationAndProjection.cs" Link="Editor/FoxRun/Decomposed/ValidationAndProjection.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/NamingAndUtilities.cs" Link="Editor/FoxRun/Decomposed/NamingAndUtilities.cs" />
    <Compile Include="../../Editor/FoxRun/Decomposed/Ros2CustomCdrEmitter/Shapes.cs" Link="Editor/FoxRun/Decomposed/Shapes.cs" />
    <Compile Include="../../../dev.unity2foxglove.sdk/Tests/Unit/Harness/FoxRunAnalyzerTestComposition.cs"
             Link="Harness/FoxRunAnalyzerTestComposition.cs" />
    <Compile Include="../../../dev.unity2foxglove.sdk/Tests/Unit/Fixtures/UnityEngineMathTypes.cs"
             Link="CompileStubs/UnityEngineMathTypes.cs" />
    <Compile Include="../../../../Unity2Foxglove/Assets/Scripts/ManualAcceptance/Phase186ManualInteractionState.cs"
             Link="ManualAcceptance/Phase186ManualInteractionState.cs" />
  </ItemGroup>
</Project>
