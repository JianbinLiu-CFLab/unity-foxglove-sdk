<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="..\Shared\FoxgloveSourceEmitter\**\*.cs" LinkBase="Shared\FoxgloveSourceEmitter" />
    <Compile Include="..\Shared\TypedMessagePack\**\*.cs" LinkBase="Shared\TypedMessagePack" />
    <Compile Include="..\Shared\FoxServiceSourceEmitter\**\*.cs" LinkBase="Shared\FoxServiceSourceEmitter" />
    <Compile Include="..\Shared\FoxServiceSchema\**\*.cs" LinkBase="Shared\FoxServiceSchema" />
    <Compile Include="..\Shared\FoxServiceDtoValidation\**\*.cs" LinkBase="Shared\FoxServiceDtoValidation" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModel\EncodingVariantAvailability.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModel\GenerationMember.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModel\GenerationModel.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModel\GenerationType.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModel\NormalizedScheduleTuple.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModelValidator\ValidationRules.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\Decomposed\FoxRunGenerationModelValidator\ValidationTopology.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunCanonicalTypeNormalizer.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunEmissionTypeNameFormatter.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGeneratedMemberIdentity.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationDescriptorComparer.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationDescriptorConstants.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationDescriptorJsonWriter.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationMemberContracts.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationModel.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunGenerationModelValidator.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunProtobufContractBuilder.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunProtobufFieldNumber.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="..\Shared\FoxRunDescriptor\FoxRunTypeShape.cs" LinkBase="Shared/FoxRunDescriptor" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep compatible with Unity's built-in Roslyn; 4.2.0 is the tested package pin. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
