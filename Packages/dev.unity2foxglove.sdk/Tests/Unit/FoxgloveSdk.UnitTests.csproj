<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IncludeRos2ForUnityNative Condition="'$(IncludeRos2ForUnityNative)' == ''">false</IncludeRos2ForUnityNative>
    <IncludeRos2ForUnityAdapter Condition="'$(IncludeRos2ForUnityNative)' == 'true' and '$(IncludeRos2ForUnityAdapter)' == ''">true</IncludeRos2ForUnityAdapter>
    <IncludeRos2ForUnityAdapter Condition="'$(IncludeRos2ForUnityAdapter)' == ''">false</IncludeRos2ForUnityAdapter>
    <IncludeRos2Bridge Condition="'$(IncludeRos2Bridge)' == ''">false</IncludeRos2Bridge>
    <DefineConstants Condition="'$(IncludeRos2ForUnityNative)' == 'true'">$(DefineConstants);UNITY2FOXGLOVE_ROS2_FOR_UNITY</DefineConstants>
    <Phase179OptionalCompilationLane>default</Phase179OptionalCompilationLane>
    <Phase179OptionalCompilationLane Condition="'$(IncludeRos2ForUnityAdapter)' == 'true'">adapter</Phase179OptionalCompilationLane>
    <Phase179OptionalCompilationLane Condition="'$(IncludeRos2ForUnityNative)' == 'true'">native</Phase179OptionalCompilationLane>
    <AssemblyName Condition="'$(IncludeRos2ForUnityNative)' == 'true'">Unity2Foxglove.Ros2ForUnity.Native</AssemblyName>
    <OutputPath>$(BaseOutputPath)$(Phase179OptionalCompilationLane)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Phase179OptionalCompilationLane)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Shared SDK compile surface (single source of truth with the console runner). -->
  <Import Project="../FoxgloveSdk.TestSurface.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**/*.cs;obj/**/*.cs;../NativeCompileStubs/**/*.cs" />
    <Compile Remove="Ros2ForUnity/**/*.cs;Architecture/FoxRunRos2NativeBoundaryTests.cs;Manager/FoxRunRos2CustomTypesupportInspectorPresentationTests.cs;FoxRun/FoxRunRos2*.cs;FoxRun/FoxRunCustomNativeContractDemandPolicyTests.cs;FoxRun/Fixtures/Phase181CustomInterfaceFixture.cs;Harness/R2fuGuardHelperOptimizationTests.cs;Harness/SensorRos2OptimizationTests.cs"
             Condition="'$(IncludeRos2ForUnityAdapter)' != 'true' and '$(IncludeRos2ForUnityNative)' != 'true'" />
    <Compile Remove="Ros2ForUnity/FoxRunAnalyzerCompositionContractTests.cs"
             Condition="'$(IncludeRos2Bridge)' != 'true'" />
    <Compile Include="../AdapterCompileStubs/FoxgloveLogHubCompileStubs.cs" Link="AdapterCompileStubs/FoxgloveLogHubCompileStubs.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../NativeCompileStubs/Ros2ForUnityNativeCompileStubs.cs" Link="NativeCompileStubs/Ros2ForUnityNativeCompileStubs.cs" Condition="'$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../NativeCompileStubs/FoxRunCustomRos2InterfaceCompileStubs.cs" Link="NativeCompileStubs/FoxRunCustomRos2InterfaceCompileStubs.cs" Condition="'$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../../../dev.unity2foxglove.ros2forunity/Editor/Ros2ForUnityCustomTypesupportSelectionTransaction.cs" Link="Ros2ForUnityEditor/Ros2ForUnityCustomTypesupportSelectionTransaction.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../../../dev.unity2foxglove.ros2forunity/Editor/Ros2ForUnityCustomTypesupportDiscovery.cs" Link="Ros2ForUnityEditor/Ros2ForUnityCustomTypesupportDiscovery.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../../../dev.unity2foxglove.ros2forunity/Editor/Ros2ForUnityCustomTypesupportPreflight.cs" Link="Ros2ForUnityEditor/Ros2ForUnityCustomTypesupportPreflight.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../../../dev.unity2foxglove.ros2forunity/Editor/Ros2ForUnityEditorRestartRelay.cs" Link="Ros2ForUnityEditor/Ros2ForUnityEditorRestartRelay.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="../../../dev.unity2foxglove.ros2bridge/Editor/FoxRun/Ros2CustomCdrEmitter.cs" Link="Ros2BridgeEditor/Ros2CustomCdrEmitter.cs" Condition="'$(IncludeRos2Bridge)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test helpers (also compiled by the console runner). -->
    <Compile Include="../Runtime/McapRecordReader.cs" Link="TestHelpers/McapRecordReader.cs" />
    <Compile Include="../Runtime/ValidationCategory.cs" Link="TestHarness/ValidationCategory.cs" />
    <Compile Include="../Runtime/ValidationEvidence.cs" Link="TestHarness/ValidationEvidence.cs" />
    <Compile Include="../Runtime/PhaseValidationCase.cs" Link="TestHarness/PhaseValidationCase.cs" />
    <Compile Include="../Runtime/FoxRunGenerationDescriptorJsonReader.cs" Link="TestHelpers/FoxRunGenerationDescriptorJsonReader.cs" />
  </ItemGroup>

  <Target Name="ValidatePhase179NativeCompileSurface" BeforeTargets="CoreCompile" Condition="'$(IncludeRos2ForUnityNative)' == 'true'">
    <ItemGroup>
      <_Phase179Contract Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2GeneratedContract'" />
      <_Phase179Registrar Include="@(Compile)" Condition="'%(Compile.Filename)' == 'IFoxRunRos2SubscriptionRegistrar'" />
      <_Phase179LifecycleGate Include="@(Compile)" Condition="'%(Compile.Filename)' == 'Ros2ForUnityNativeBridgeLifecycleGate'" />
      <_Phase179InboundHub Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2SubscriptionHub'" />
      <_Phase179InboundBackend Include="@(Compile)" Condition="'%(Compile.Filename)' == 'Ros2ForUnityFoxRunInboundBackend'" />
      <_Phase179InboundDiagnostics Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2SubscriptionDiagnostics'" />
      <_Phase179CompileStub Include="@(Compile)" Condition="'%(Compile.Filename)' == 'Ros2ForUnityNativeCompileStubs'" />
      <_Phase179UnrelatedNative Include="@(Compile)" Condition="$([System.String]::Copy('%(Compile.Identity)').Replace('\\','/').Contains('/Runtime/Native/')) and '%(Compile.Filename)' != 'Ros2ForUnityNativeBridgeLifecycleGate' and !$([System.String]::Copy('%(Compile.Identity)').Replace('\\','/').Contains('/Runtime/Native/FoxRun/'))" />
    </ItemGroup>
    <Error Condition="!$([System.String]::Copy('$(DefineConstants)').Contains('UNITY2FOXGLOVE_ROS2_FOR_UNITY'))" Text="Phase179 Native lane must define UNITY2FOXGLOVE_ROS2_FOR_UNITY." />
    <Error Condition="'@(_Phase179Contract)' == '' or '@(_Phase179Registrar)' == '' or '@(_Phase179LifecycleGate)' == '' or '@(_Phase179InboundHub)' == '' or '@(_Phase179InboundBackend)' == '' or '@(_Phase179InboundDiagnostics)' == '' or '@(_Phase179CompileStub)' == ''" Text="Phase179 Native lane compiled no named host/binding/lifecycle/stub surface (vacuous green)." />
    <Error Condition="'@(_Phase179UnrelatedNative)' != ''" Text="Phase179 focused Native lane included unrelated native bridge sources: @(_Phase179UnrelatedNative)." />
  </Target>

  <Target Name="ValidatePhase181CustomRos2CompileSurface" BeforeTargets="CoreCompile" Condition="'$(IncludeRos2ForUnityNative)' == 'true'">
    <ItemGroup>
      <_Phase181CustomInterfaceStub Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunCustomRos2InterfaceCompileStubs'" />
      <_Phase181CustomCatalogContract Include="@(Compile)" Condition="'%(Compile.Filename)' == 'IFoxRunRos2CustomTypesupportCatalog'" />
      <_Phase181CustomCatalogRegistry Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2CustomTypesupportCatalogRegistry'" />
      <_Phase181CustomCatalogReadiness Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2CustomTypesupportReadiness'" />
      <_Phase181CustomTransportHost Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2CustomNativeTransportHost'" />
      <_Phase181CustomPublisherHub Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2CustomPublisherHub'" />
      <_Phase181CustomPublisherBinding Include="@(Compile)" Condition="'%(Compile.Filename)' == 'FoxRunRos2CustomPublisherBinding'" />
      <_Phase181CustomPublisherSource Include="@(Compile)" Condition="'%(Compile.Filename)' == 'IFoxRunRos2CustomPublisherSource'" />
      <_Phase181CustomSubscriptionSource Include="@(Compile)" Condition="'%(Compile.Filename)' == 'IFoxRunRos2CustomSubscriptionSource'" />
      <_Phase181CustomMapperEmitter Include="@(Compile)" Condition="'%(Compile.Filename)' == 'Ros2CustomDtoMapperEmitter'" />
      <_Phase181CustomPublishEmitter Include="@(Compile)" Condition="'%(Compile.Filename)' == 'Ros2CustomPublishEmitter'" />
    </ItemGroup>
    <Error Condition="'@(_Phase181CustomInterfaceStub)' == '' or '@(_Phase181CustomCatalogContract)' == '' or '@(_Phase181CustomCatalogRegistry)' == '' or '@(_Phase181CustomCatalogReadiness)' == '' or '@(_Phase181CustomTransportHost)' == '' or '@(_Phase181CustomPublisherHub)' == '' or '@(_Phase181CustomPublisherBinding)' == '' or '@(_Phase181CustomPublisherSource)' == '' or '@(_Phase181CustomSubscriptionSource)' == '' or '@(_Phase181CustomMapperEmitter)' == '' or '@(_Phase181CustomPublishEmitter)' == ''" Text="Phase181 Native lane compiled no named custom interface/catalog/transport/generator surface (vacuous green)." />
  </Target>
</Project>
