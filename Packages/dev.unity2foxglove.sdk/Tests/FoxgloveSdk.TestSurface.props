<Project>
  <!--
    Shared SDK compile surface for the .NET test projects. Paths are anchored
    with $(MSBuildThisFileDirectory) so they resolve from this file's location
    regardless of the importing project's directory.

    Currently imported by the xUnit project (Tests/Unit) only. The console
    runner (Tests/Runtime/FoxgloveSdk.Tests.csproj) still keeps its own inline
    copy of this surface; consolidating it onto this props is deferred to the
    Phase 4 cleanup, because several console source-text checks assert on the
    csproj's literal Compile/PackageReference entries and will be migrated to
    Roslyn at the same time.
  -->
  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.4" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Attributes/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxRun/FoxRun*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxRun/FoxgloveLogHub.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxRun/IFoxgloveLogConditionSource.cs" Condition="'$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxRun/FoxTopic*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxRun/IFoxTopic*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxService/FoxgloveGeneratedServiceDescriptor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/FoxService/FoxgloveLocalServiceCall.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/*Builder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/*Debouncer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/*Normalizer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/*Validator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/*State.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Manager/Coordinate*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Profiling/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Publishing/FoxglovePublisherEncoding.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Components/Publishing/FoxglovePublisherRate.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Core/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Protocol/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Transport/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/IO/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Ros2Bridge/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Sensors/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../Runtime/Sensors/**/VirtualLidar.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/VirtualLidarScanBuffers.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/VirtualLidarScanFramePublisher.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/VirtualLidarScanScheduler.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/VirtualImu.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/SensorUnitProfile.cs;$(MSBuildThisFileDirectory)../Runtime/Sensors/**/LidarUnityNumericsConversions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/MessageDefinitions/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/Registry/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/Camera/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/PointCloud/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/Imu/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/MsgPack/FoxgloveMsgPackWriter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/Ros2Msg/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/*Publisher.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/Channels/**/*.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/FoxgloveCameraPublisher.*.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/FoxglovePointCloudPublisher.*.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/ImuMessageBuilder.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/PointCloudTransformFrameBuilder.cs;$(MSBuildThisFileDirectory)../Runtime/Schemas/Proto/**/CameraCaptureResources.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Runtime/Utilities/*.cs" />

    <Compile Include="$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Runtime/**/*.cs" LinkBase="Ros2ForUnityRuntime" Condition="('$(IncludeRos2ForUnityAdapter)' == 'true' or '$(IncludeRos2ForUnityNative)' == 'true') and Exists('$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Runtime')" />
    <Compile Remove="$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Runtime/Native/**/*.cs" Condition="'$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Runtime/Native/FoxRun/**/*.cs" LinkBase="Ros2ForUnityRuntime/Native/FoxRun" Condition="'$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Runtime/Native/Ros2ForUnityNativeBridgeLifecycleGate.cs" Link="Ros2ForUnityRuntime/Native/Ros2ForUnityNativeBridgeLifecycleGate.cs" Condition="'$(IncludeRos2ForUnityNative)' == 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxgloveSourceEmitter/**/*.cs" LinkBase="Shared/FoxgloveSourceEmitter" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxServiceSourceEmitter/**/*.cs" LinkBase="Shared/FoxServiceSourceEmitter" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxServiceSchema/**/*.cs" LinkBase="Shared/FoxServiceSchema" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxServiceDtoValidation/**/*.cs" LinkBase="Shared/FoxServiceDtoValidation" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/SourceGenerators/src/**/*.cs" LinkBase="SourceGenerators" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxRunManifest/**/*.cs" LinkBase="Shared/FoxRunManifest" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxRunSubscriptionProtocolEditorLabels.cs" Link="Shared/FoxRunSubscriptionProtocolEditorLabels.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxRunRos2SubscriptionInspectorPresentation.cs" Link="Shared/FoxRunRos2SubscriptionInspectorPresentation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity/Editor/Ros2ForUnityRuntimeCapabilityModel.cs" Link="Ros2ForUnityEditor/Ros2ForUnityRuntimeCapabilityModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/FoxRunDescriptor/**/*.cs" LinkBase="Shared/FoxRunDescriptor" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/OpenH264/**/*.cs" LinkBase="Shared/OpenH264" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/Process/**/*.cs" LinkBase="Shared/Process" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/Shared/SchemaManifest/**/*.cs" LinkBase="Shared/SchemaManifest" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxrunManifestWriter.cs" Link="Editor/FoxRun/FoxrunManifestWriter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxRunSchemaInfoWriter.cs" Link="Editor/FoxRun/FoxRunSchemaInfoWriter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxRunReflectionGenerationModelLowerer.cs" Link="Editor/FoxRun/FoxRunReflectionGenerationModelLowerer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxRunProtobufReflectionTypeShapeBuilder.cs" Link="Editor/FoxRun/FoxRunProtobufReflectionTypeShapeBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxRunReflectionRos2MessageShapeBuilder.cs" Link="Editor/FoxRun/FoxRunReflectionRos2MessageShapeBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxRunReflectionRos2CustomDtoShapeBuilder.cs" Link="Editor/FoxRun/FoxRunReflectionRos2CustomDtoShapeBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxrunMemberData.cs" Link="Editor/FoxRun/FoxrunMemberData.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Editor/FoxRun/FoxServiceDtoReflectionValidator.cs" Link="Editor/FoxRun/FoxServiceDtoReflectionValidator.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeRos2ForUnityNative)' == 'true'">
    <Reference Include="ros2cs_common">
      <HintPath>$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity.runtime.jazzy.win64/Runtime/Ros2ForUnity/Plugins/ros2cs_common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ros2cs_core">
      <HintPath>$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity.runtime.jazzy.win64/Runtime/Ros2ForUnity/Plugins/ros2cs_core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="std_msgs_assembly">
      <HintPath>$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity.runtime.jazzy.win64/Runtime/Ros2ForUnity/Plugins/std_msgs_assembly.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="geometry_msgs_assembly">
      <HintPath>$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity.runtime.jazzy.win64/Runtime/Ros2ForUnity/Plugins/geometry_msgs_assembly.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sensor_msgs_assembly">
      <HintPath>$(MSBuildThisFileDirectory)../../dev.unity2foxglove.ros2forunity.runtime.jazzy.win64/Runtime/Ros2ForUnity/Plugins/sensor_msgs_assembly.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
