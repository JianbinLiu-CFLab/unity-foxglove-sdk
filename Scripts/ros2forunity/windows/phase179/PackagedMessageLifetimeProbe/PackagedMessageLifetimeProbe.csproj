<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright (c) 2026 Jianbin Liu and Unity2Foxglove contributors. SPDX-License-Identifier: Apache-2.0 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimePackageRoot>$(RepoRoot)Packages\dev.unity2foxglove.ros2forunity.runtime.$(Distro).win64\Runtime\Ros2ForUnity</RuntimePackageRoot>
    <PluginsRoot>$(RuntimePackageRoot)\Plugins</PluginsRoot>
    <BaseOutputPath>$(RepoRoot)build\phase179b\probe\$(Distro)\bin\</BaseOutputPath>
  </PropertyGroup>

  <Target Name="ValidateDistro" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Distro)' != 'humble' and '$(Distro)' != 'jazzy' and '$(Distro)' != 'lyrical'"
           Text="Set -p:Distro=humble, jazzy, or lyrical." />
    <Error Condition="!Exists('$(PluginsRoot)\ros2cs_core.dll')"
           Text="Tracked runtime package is missing ros2cs_core.dll: $(PluginsRoot)" />
  </Target>

  <ItemGroup>
    <Reference Include="ros2cs_common" HintPath="$(PluginsRoot)\ros2cs_common.dll" Private="true" />
    <Reference Include="ros2cs_core" HintPath="$(PluginsRoot)\ros2cs_core.dll" Private="true" />
    <Reference Include="builtin_interfaces_assembly" HintPath="$(PluginsRoot)\builtin_interfaces_assembly.dll" Private="true" />
    <Reference Include="std_msgs_assembly" HintPath="$(PluginsRoot)\std_msgs_assembly.dll" Private="true" />
    <Reference Include="geometry_msgs_assembly" HintPath="$(PluginsRoot)\geometry_msgs_assembly.dll" Private="true" />
    <Reference Include="sensor_msgs_assembly" HintPath="$(PluginsRoot)\sensor_msgs_assembly.dll" Private="true" />
  </ItemGroup>
</Project>
