<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright (c) 2026 Jianbin Liu and Unity2Foxglove contributors. SPDX-License-Identifier: Apache-2.0 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeRos2ForUnityNative>true</IncludeRos2ForUnityNative>
    <IncludeRos2ForUnityAdapter>true</IncludeRos2ForUnityAdapter>
    <DefineConstants>$(DefineConstants);UNITY2FOXGLOVE_ROS2_FOR_UNITY;UNITY_EDITOR_WIN</DefineConstants>
    <NoWarn>$(NoWarn);CS0067;CS0414;CS0649;CS1998;CS8632</NoWarn>
    <SdkTestsRoot>$(RepoRoot)Packages\dev.unity2foxglove.sdk\Tests</SdkTestsRoot>
    <PluginsRoot>$(RepoRoot)Packages\dev.unity2foxglove.ros2forunity.runtime.$(Distro).win64\Runtime\Ros2ForUnity\Plugins</PluginsRoot>
    <LiveFacadesRoot>$(RepoRoot)Scripts\smoke\ros2\pointcloud2_inbound_topic_switch\PointCloud2InboundTopicSwitchProbe\Host</LiveFacadesRoot>
    <BaseOutputPath>$(RepoRoot)build\smoke\ros2\imu-inbound-frame-id-limit\$(Distro)\bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- Same product compile surface as the Native xUnit lane, with live R2FU facades instead of compile stubs. -->
  <Import Project="$(SdkTestsRoot)\FoxgloveSdk.TestSurface.props" />

  <Target Name="ValidateDistro" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Distro)' != 'humble' and '$(Distro)' != 'jazzy' and '$(Distro)' != 'lyrical'"
           Text="Set -p:Distro=humble, jazzy, or lyrical." />
    <Error Condition="!Exists('$(PluginsRoot)\ros2cs_core.dll')"
           Text="Tracked runtime package is missing ros2cs_core.dll: $(PluginsRoot)" />
  </Target>

  <ItemGroup>
    <Compile Include="*.cs;Host\*.cs;Scenario\*.cs" />
    <Compile Include="$(LiveFacadesRoot)\LiveRos2Facades.cs" Link="Host\LiveRos2Facades.cs" />
    <Compile Include="$(SdkTestsRoot)\AdapterCompileStubs\FoxgloveLogHubCompileStubs.cs" Link="HostStubs\FoxgloveLogHubCompileStubs.cs" />
    <Compile Include="$(SdkTestsRoot)\NativeCompileStubs\FoxRunCustomRos2InterfaceCompileStubs.cs" Link="HostStubs\FoxRunCustomRos2InterfaceCompileStubs.cs" />
    <Compile Include="$(SdkTestsRoot)\Unit\Fixtures\UnityEngineMathTypes.cs" Link="HostStubs\UnityEngineMathTypes.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Remove="ros2cs_common;ros2cs_core;builtin_interfaces_assembly;std_msgs_assembly;geometry_msgs_assembly;sensor_msgs_assembly" />
    <Reference Include="ros2cs_common" HintPath="$(PluginsRoot)\ros2cs_common.dll" Private="true" />
    <Reference Include="ros2cs_core" HintPath="$(PluginsRoot)\ros2cs_core.dll" Private="true" />
    <Reference Include="builtin_interfaces_assembly" HintPath="$(PluginsRoot)\builtin_interfaces_assembly.dll" Private="true" />
    <Reference Include="std_msgs_assembly" HintPath="$(PluginsRoot)\std_msgs_assembly.dll" Private="true" />
    <Reference Include="geometry_msgs_assembly" HintPath="$(PluginsRoot)\geometry_msgs_assembly.dll" Private="true" />
    <Reference Include="sensor_msgs_assembly" HintPath="$(PluginsRoot)\sensor_msgs_assembly.dll" Private="true" />
  </ItemGroup>
</Project>
