{
  "name": "foxrun-publish-panel",
  "displayName": "FoxRun Publish",
  "description": "Publish typed JSON, Protobuf, and MessagePack FoxRun subscription contracts to Unity.",
  "publisher": "unity2foxglove",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "foxglove-extension build",
    "package": "foxglove-extension package",
    "local-install": "foxglove-extension install",
    "typecheck": "node -e \"require('fs').mkdirSync('../../../build/foxglove-extensions/foxrun-publish-panel',{recursive:true})\" && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@foxglove/extension": "2.54.0"
  },
  "devDependencies": {
    "create-foxglove-extension": "1.3.2",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
